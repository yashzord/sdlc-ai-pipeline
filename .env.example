# --- AI (recommended) ---
# Shared default for all users. Google AI Studio key — free tier: https://aistudio.google.com/apikey
# Users can also bring their own AI (one-click OpenRouter connect, or paste a
# Gemini/Claude/Groq/OpenRouter key), which takes precedence over this.
GEMINI_API_KEY=
# Optional default-model override (defaults to gemini-2.5-flash)
GEMINI_MODEL=

# --- GitHub OAuth app (required) ---
# Create at https://github.com/settings/developers
# Callback URL: https://<your-domain>/api/auth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Sessions (required) ---
# 32+ random characters, e.g. `openssl rand -hex 32`. Encrypts auth cookies.
SESSION_SECRET=

# --- Persistence (optional — enables run history + resume) ---
# Supabase project URL and service-role secret (Project Settings -> API keys).
# Without these, runs live only in the browser tab.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Jira OAuth (optional — enables one-click "Connect Jira") ---
# Create an OAuth 2.0 (3LO) app at https://developer.atlassian.com/console/myapps
# Scopes: read:jira-work write:jira-work read:me offline_access
# Callback URL: https://<your-domain>/api/jira/oauth/callback
# Without these, users can still connect Jira by pasting an API token.
JIRA_CLIENT_ID=
JIRA_CLIENT_SECRET=

# --- Vercel Integration OAuth (optional — enables one-click "Connect Vercel") ---
# Create an integration at https://vercel.com/dashboard/integrations/console
# Redirect URL: https://<your-domain>/api/vercel/oauth/callback
# Without these, users can still connect Vercel by pasting an access token.
VERCEL_INTEGRATION_SLUG=
VERCEL_CLIENT_ID=
VERCEL_CLIENT_SECRET=
