# --- AI (required) ---
# Google AI Studio key — free tier: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional model override (defaults to gemini-2.5-flash with fallbacks)
GEMINI_MODEL=

# --- GitHub OAuth app (required) ---
# Create at https://github.com/settings/developers
# Callback URL: https://<your-domain>/api/auth/callback  (or http://localhost:3000/api/auth/callback in dev)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Sessions (required) ---
# 32+ random characters, e.g. `openssl rand -hex 32`. Encrypts auth cookies.
SESSION_SECRET=
